#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly HY2_BIN=/usr/local/bin/hysteria
readonly HY2_DIR=/etc/hysteria
readonly HY2_CONFIG=$HY2_DIR/config.yaml
readonly HY2_INFO=$HY2_DIR/server-info
readonly HY2_SERVICE=hysteria-server.service
readonly BACKUP_DIR=$HY2_DIR/backup
readonly OFFICIAL_INSTALLER=https://get.hy2.sh/
readonly DEFAULT_MASQUERADE=https://www.example.com/

log(){ printf '\033[1;32m[+]\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die(){ printf '\033[1;31m[-]\033[0m %s\n' "$*" >&2; exit 1; }
trap 'rc=$?; printf "\033[1;31m[-]\033[0m 失败：第 %s 行，退出码 %s\n" "${BASH_LINENO[0]:-?}" "$rc" >&2; exit "$rc"' ERR

root(){ [[ $EUID -eq 0 ]] || die '请使用 root 运行。'; }
os_check(){
  [[ -r /etc/os-release ]] || die '无法识别操作系统。'
  source /etc/os-release
  case "$ID" in
    debian) [[ ${VERSION_ID%%.*} =~ ^[0-9]+$ ]] && (( ${VERSION_ID%%.*} >= 11 )) || die '需要 Debian 11+。';;
    ubuntu) [[ ${VERSION_ID%%.*} =~ ^[0-9]+$ ]] && (( ${VERSION_ID%%.*} >= 22 )) || die '需要 Ubuntu 22.04+。';;
    *) die "仅支持 Debian 11+ / Ubuntu 22.04+；当前：${PRETTY_NAME:-unknown}";;
  esac
  command -v systemctl >/dev/null || die '系统没有 systemd/systemctl。'
}
deps(){
  local miss=() c
  for c in bash curl grep sed awk ss getent openssl; do command -v "$c" >/dev/null 2>&1 || miss+=("$c"); done
  ((${#miss[@]}==0)) && return
  command -v apt-get >/dev/null 2>&1 || die "缺少依赖：${miss[*]}，且无法自动安装。"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y ca-certificates curl grep sed gawk iproute2 openssl
}
valid_domain(){ [[ ${#1} -le 253 && "$1" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]; }
valid_email(){ [[ ${#1} -le 254 && "$1" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]]; }
valid_url(){ [[ ${#1} -le 2048 && "$1" =~ ^https://[^[:space:]]+$ ]]; }
yaml_sq(){ local s=$1; s=${s//\'/\'\'}; printf "'%s'" "$s"; }
gen_pass(){ LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40; printf '\n'; }

check_dns(){
  local d=$1 v4 v6 pub4 records
  v4=$(getent ahostsv4 "$d" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ' || true)
  v6=$(getent ahostsv6 "$d" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ' || true)
  [[ -n "$v4$v6" ]] || die "$d 没有 A/AAAA 解析。"
  printf 'DNS A : %s\n' "${v4:-none}"
  printf 'DNS AAAA: %s\n' "${v6:-none}"
  pub4=$(curl -4fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)
  if [[ -n "$pub4" ]]; then
    records="$v4"
    if [[ -n "$records" && " $records " != *" $pub4 "* ]]; then
      warn "当前公网 IPv4 ($pub4) 不在域名 A 记录中；若你使用 NAT/CDN/IPv6，请人工确认。"
    fi
  fi
}
check_ports(){
  if ss -H -ltn 'sport = :443' 2>/dev/null | grep -q .; then ss -ltnp 'sport = :443' || true; die 'TCP/443 已被占用；ACME TLS-ALPN 需要 TCP/443。'; fi
  if ss -H -lnu 'sport = :443' 2>/dev/null | grep -q .; then ss -lnup 'sport = :443' || true; die 'UDP/443 已被占用；Hysteria 需要 UDP/443。'; fi
}
backup(){
  [[ -f $HY2_CONFIG ]] || return 0
  mkdir -p "$BACKUP_DIR"
  local f="$BACKUP_DIR/config.yaml.$(date +%Y%m%d-%H%M%S)"
  cp -a "$HY2_CONFIG" "$f"; chmod 600 "$f"; log "旧配置已备份：$f"
}
official_install(){
  log '使用 Hysteria 官方安装脚本。'
  HYSTERIA_USER=root bash <(curl -fsSL --retry 5 --retry-delay 2 --retry-max-time 60 "$OFFICIAL_INSTALLER")
  [[ -x $HY2_BIN ]] || die "官方安装后未找到 $HY2_BIN。"
}
write_config(){
  local d=$1 e=$2 p=$3 m=$4
  mkdir -p "$HY2_DIR"; chmod 700 "$HY2_DIR"
  cat > "$HY2_CONFIG.new" <<EOF2
# Generated by hy2-installer-optimized.sh
listen: :443

acme:
  domains:
    - $(yaml_sq "$d")
  email: $(yaml_sq "$e")

auth:
  type: password
  password: $(yaml_sq "$p")

masquerade:
  type: proxy
  proxy:
    url: $(yaml_sq "$m")
    rewriteHost: true
EOF2
  chmod 600 "$HY2_CONFIG.new"; mv -f "$HY2_CONFIG.new" "$HY2_CONFIG"
}
write_info(){
  local d=$1 e=$2 p=$3
  local uri="hysteria2://${p}@${d}:443/?sni=${d}#HY2"
  cat > "$HY2_INFO.new" <<EOF2
Hysteria 2 server information
Generated: $(date -Is)
Server: $d:443
SNI: $d
Password: $p
Hysteria2 URI: $uri
Config: $HY2_CONFIG
Service: $HY2_SERVICE
EOF2
  chmod 600 "$HY2_INFO.new"; mv -f "$HY2_INFO.new" "$HY2_INFO"
}
start(){
  systemctl daemon-reload
  systemctl enable "$HY2_SERVICE" >/dev/null
  systemctl restart "$HY2_SERVICE"
  sleep 2
  systemctl is-active --quiet "$HY2_SERVICE" || { systemctl --no-pager --full status "$HY2_SERVICE" || true; journalctl --no-pager -u "$HY2_SERVICE" -n 80 || true; die 'Hysteria 服务启动失败。'; }
}
install_server(){
  root; os_check; deps
  local d e m p
  read -r -p '请输入 ACME 域名: ' d; d=${d,,}; valid_domain "$d" || die '域名格式无效。'
  read -r -p '请输入 ACME 邮箱: ' e; valid_email "$e" || die '邮箱格式无效。'
  read -r -p "伪装网站 [${DEFAULT_MASQUERADE}]: " m; m=${m:-$DEFAULT_MASQUERADE}; valid_url "$m" || die '伪装网站必须是 https:// URL。'
  log '检查 DNS 和 443 端口。'; check_dns "$d"; check_ports
  warn '请确认 VPS 云安全组/防火墙已允许 TCP/443 与 UDP/443；脚本不会自动改云安全组。'
  p=$(gen_pass); [[ $p =~ ^[A-Za-z0-9]{40}$ ]] || die '随机密码生成失败。'
  backup; official_install; write_config "$d" "$e" "$p" "$m"; write_info "$d" "$e" "$p"; start
  printf '\n========================================\nHysteria 2 安装完成\n========================================\nServer   : %s:443\nSNI      : %s\nPassword : %s\n\nHysteria2 URI:\nhysteria2://%s@%s:443/?sni=%s#HY2\n\nConfig: %s\nInfo  : %s\n\n' "$d" "$d" "$p" "$p" "$d" "$d" "$HY2_CONFIG" "$HY2_INFO"
}
update_server(){
  root; os_check; deps; official_install
  [[ -f $HY2_CONFIG ]] || { warn '没有配置文件，仅完成官方二进制更新。'; return; }
  systemctl daemon-reload; systemctl restart "$HY2_SERVICE"
  systemctl is-active --quiet "$HY2_SERVICE" || { journalctl --no-pager -u "$HY2_SERVICE" -n 80 || true; die '更新后服务启动失败。'; }
  "$HY2_BIN" version || true
}
status_server(){ root; systemctl --no-pager --full status "$HY2_SERVICE"; }
logs_server(){ root; journalctl --no-pager -u "$HY2_SERVICE" -n 100; }
uninstall_server(){
  root; read -r -p '输入 YES 确认卸载：' x; [[ $x == YES ]] || { log '已取消。'; return; }
  HYSTERIA_USER=root bash <(curl -fsSL --retry 5 --retry-delay 2 --retry-max-time 60 "$OFFICIAL_INSTALLER") --remove
  warn "配置及备份保留在 $HY2_DIR；确认无用后可手动删除。"
}
self_test(){
  root; os_check; deps; bash -n "$0"
  local p; p=$(gen_pass); [[ $p =~ ^[A-Za-z0-9]{40}$ ]]
  valid_domain hy.example.com; valid_email test@example.com; valid_url https://www.example.com/
  log 'self-test 通过：Bash 语法、输入校验和密码生成正常。'
  log 'self-test 不会申请 ACME、不启动真实服务。'
}
usage(){ cat <<EOF2
用法：
  $0                 交互菜单
  $0 install         安装/重装
  $0 update          更新官方 Hysteria
  $0 status          查看状态
  $0 logs            查看日志
  $0 uninstall       卸载
  $0 self-test       自检
EOF2
}
menu(){
  while :; do
    printf '\nHysteria 2 一键管理\n1) 安装/重装\n2) 更新\n3) 状态\n4) 日志\n5) 卸载\n0) 退出\n\n'
    read -r -p '请选择: ' x
    case $x in 1) install_server;;2) update_server;;3) status_server;;4) logs_server;;5) uninstall_server;;0) exit 0;;*) warn '无效选项。';; esac
  done
}
case ${1:-} in
  install) install_server;; update) update_server;; status) status_server;; logs) logs_server;; uninstall) uninstall_server;; self-test) self_test;; -h|--help) usage;; '') menu;; *) usage; exit 2;;
esac
